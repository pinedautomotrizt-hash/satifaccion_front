---
interface Props {
  nivel: 1 | 2 | 3;
}
const { nivel } = Astro.props;

const boca = {
  1: 'M34 72 Q50 58 66 72',   // triste
  2: 'M34 68 L66 68',         // neutral
  3: 'M32 62 Q50 80 68 62',   // feliz
}[nivel];
---
<svg viewBox="0 0 100 100" aria-hidden="true">
  <circle cx="50" cy="50" r="46" fill="currentColor" />
  <circle cx="36" cy="40" r="6" fill="#fff" />
  <circle cx="64" cy="40" r="6" fill="#fff" />
  <path d={boca} stroke="#fff" stroke-width="7" stroke-linecap="round" fill="none" />
</svg>
